# development | production (production turns the dev-JWT-secret warning into an error log)
APP_ENV=development

# ---- Database ----
# Postgres (matches docker-compose.yml). Note the "+asyncpg" async driver.
DATABASE_URL=postgresql+asyncpg://financeai:financeai@localhost:5432/financeai
# Zero-install fallback — no Docker/Postgres needed, writes a local file:
# DATABASE_URL=sqlite+aiosqlite:///./financeai.db

# Dev convenience: auto-create tables on startup (checkfirst, idempotent).
# Set to false to manage schema exclusively with Alembic migrations.
AUTO_CREATE_TABLES=true

# ---- Auth ----
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ---- Anthropic (Claude) ----
# Leave blank to run without AI — transactions still save, categorized as "Other".
ANTHROPIC_API_KEY=
# Opus is the capable default. For high-volume categorization, claude-haiku-4-5
# is ~5x cheaper and plenty capable — just swap the value below.
ANTHROPIC_MODEL=claude-opus-5

# ---- Money ----
# Currency assigned to each user's default "Cash" account (ISO-4217).
DEFAULT_CURRENCY=BDT

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
